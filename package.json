{
  "name": "ai-code-review-bot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@effect/language-service": "^0.87.1",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "latest",
    "oxlint": "1.80.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --env-file=.env.local run src/index.ts",
    "prepare": "effect-language-service patch",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "lint:anti-slop": "oxlint",
    "check": "biome check --write .",
    "check:check": "biome check .",
    "test": "bun test",
    "ci": "biome ci . && bun test && oxlint",
    "biome:start": "biome start",
    "biome:stop": "biome stop",
    "biome:clean": "biome clean",
    "biome:version": "biome version",
    "biome:rage": "biome rage",
    "migrate:eslint": "biome migrate eslint",
    "migrate:prettier": "biome migrate prettier"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "effect": ">=4.0.0-beta.102 || >=4.0.0"
  }
}
