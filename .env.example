# Groq API Key (Get yours for free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Personal Access Token (with repo scope) for local testing
GITHUB_TOKEN=github_pat_your_token_here

# Target GitHub Repository (owner/repo format)
GITHUB_REPOSITORY=owner/repo

# Path to local mock GitHub event payload (e.g., ./mock-event.json)
GITHUB_EVENT_PATH=./mock-event.json
